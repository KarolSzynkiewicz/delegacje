APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Laravel Pulse – monitoring (dashboard /pulse, tylko administrator)
PULSE_ENABLED=true

# Laravel Sail Configuration
WWWGROUP=1000
WWWUSER=1000
APP_PORT=80
FORWARD_DB_PORT=3306

# ─── External APIs ────────────────────────────────────────────────────────────
# OpenRouteService – route planning & distance calculation (https://openrouteservice.org)
# Wymagany do planowania tras w kroku 4 formularza wyjazdu (create-v2).
# Zarejestruj się na https://openrouteservice.org/dev/#/signup i wygeneruj klucz API.
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org/v2
# Nominatim / OpenStreetMap – geokodowanie adresów (https://nominatim.openstreetmap.org)
# Nie wymaga klucza API. Działa z-the-box.

# ─── MCP / AI tools ───────────────────────────────────────────────────────────
# Lokalny stdio (Cursor): php artisan mcp:start chrono-tasks — działa poza sesją
# HTTP, więc musi wiedzieć, w imieniu kogo czyta i zapisuje zadania.
# HTTP (ChatGPT / Grok): https://twoja-domena/mcp/tasks — użytkownik z OAuth.
MCP_ACTOR_USER_ID=
MCP_MAX_TASKS_PER_BUNDLE=200
MCP_MAX_CATEGORY_ASSIGNMENTS=50
MCP_MAX_SUBTASKS_PER_TASK=30
MCP_MAX_SPRINT_ASSIGNMENTS=50
# Domeny redirect URI przy rejestracji klienta OAuth. * = wszystkie.
# Przykład produkcji: https://chatgpt.com,https://chat.openai.com,https://grok.com
MCP_OAUTH_REDIRECT_DOMAINS=*
# Klucze Passport: na Railway dysk jest ulotny, więc para kluczy jest też
# trzymana w tabeli oauth_key_pairs (szyfrowane APP_KEY). PASSPORT_* nadal
# mają pierwszeństwo, jeśli je ustawisz.
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=

# ─── LLM (integracja AI w aplikacji) ──────────────────────────────────────────
# Normalnie klucz dodaje się przez UI (Akcje systemowe → Integracja AI) i ląduje
# zaszyfrowany w tabeli `llm_credentials`. Zmienne poniżej to tylko fallback,
# np. dla środowisk, gdzie sekret wstrzykuje platforma (Railway).
LLM_PROVIDER=gemini
LLM_TIMEOUT=60
LLM_MAX_TOKENS=2048

# Google AI Studio — klucz z https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Modele 2.x „myślą” przed odpowiedzią, a te tokeny liczą się do limitu odpowiedzi.
# Puste = model decyduje sam, 0 = wyłącz myślenie (taniej, szybciej, mniej dokładnie).
GEMINI_THINKING_BUDGET=

# OpenAI lub dowolne API zgodne z /chat/completions (OpenRouter, Groq, Ollama)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
